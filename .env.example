
# PostgreSQL
POSTGRES_DB=inventory
POSTGRES_USER=inventario
POSTGRES_PASSWORD=replace_with_a_local_password

# Backend
DATABASE_URL=postgresql+psycopg://inventario:replace_with_a_local_password@localhost:5432/inventory
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
# Por defecto la interfaz utiliza /api a través del proxy Vite en desarrollo
# La aplicación requiere que /api se publique bajo el mismo origen del frontend.
# Solo habilitar cookies seguras cuando se sirve bajo HTTPS:
COOKIE_SECURE=false
